# Untuk Hostinger Web Hosting (LiteSpeed/Apache). Salin ke public_html bersama fail lain dalam dist/.

# Paksa HTTPS (pemain YouTube dan banyak ciri pelayar memerlukannya)
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

ErrorDocument 404 /404.html

# Mampatan
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain
</IfModule>

# Cache: aset dalam /_astro/ bernama hash jadi selamat disimpan lama; HTML sentiasa segar
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  # Jangan ketatkan lagi: pemain YouTube memerlukan Referer dihantar
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
