---
import type { Artist } from '../lib/artists';

interface Props {
  artists: Artist[];
}
const { artists } = Astro.props;

const initial = (name: string) => (name.trim().charAt(0) || '?').toLocaleUpperCase('ms');
---

{
  artists.length > 0 && (
    <section id="artis" class="container artists">
      <div class="head">
        <p class="eyebrow">Artis</p>
        <h2 class="section-title">Kenali suara di sebalik lagu</h2>
      </div>
      <ul class="grid">
        {artists.map((a) => {
          const href = a.channelId ? `https://www.youtube.com/channel/${encodeURIComponent(a.channelId)}` : undefined;
          return (
            <li>
              <a class="card" href={href} target="_blank" rel="noopener noreferrer">
                <span class="mono" aria-hidden="true">{initial(a.name)}</span>
                <span class="name">{a.name}</span>
                <span class="count">{a.count} lagu dalam siaran</span>
                <span class="more">Lihat di YouTube &rarr;</span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )
}

<style>
  .artists {
    padding-block: 72px;
  }
  .head {
    margin-bottom: 32px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 28px 22px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
    transition: border-color 0.15s ease;
  }
  .card:hover {
    border-color: var(--orange);
  }
  .mono {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    margin-bottom: 16px;
    border: 1px solid var(--border-2);
    border-radius: 50%;
    background: var(--surface-2);
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--peach);
  }
  .name {
    font-size: 1.125rem;
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .count {
    margin: 2px 0 14px;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .more {
    margin-top: auto;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--peach);
  }
  @media (max-width: 640px) {
    .artists {
      padding-block: 48px;
    }
  }
</style>
