---
import { SITE } from '../config';

const suggest = `mailto:${SITE.contactEmail}?subject=${encodeURIComponent('Cadangan lagu untuk siaran Nasyidos')}&body=${encodeURIComponent('Tajuk lagu:\nArtis:\nPautan YouTube rasmi:\n')}`;
const contact = `mailto:${SITE.contactEmail}?subject=${encodeURIComponent('Artis / label: Nasyidos')}`;
---

<section id="cadang" class="container cta">
  <div class="card suggest">
    <h2>Ada nasyid yang anda rindu?</h2>
    <p>Cadangkan lagu dan kami akan semak sebelum dimasukkan ke dalam siaran.</p>
    <a class="btn btn-dark" href={suggest}>Cadangkan Lagu</a>
  </div>
  <div class="card artist">
    <h2>Artis atau label nasyid?</h2>
    <p>Hubungi kami untuk memasukkan karya anda, atau untuk meminta karya dikeluarkan daripada siaran.</p>
    <a class="btn btn-outline" href={contact}>Hubungi Kami</a>
  </div>
</section>

<style>
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    padding-bottom: 72px;
  }
  .card {
    flex: 1 1 440px;
    padding: 40px 36px;
    border-radius: 20px;
  }
  h2 {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.15;
  }
  p {
    margin: 0 0 24px;
    max-width: 420px;
  }
  .suggest {
    background: var(--orange);
    color: var(--navy);
  }
  .artist {
    border: 1px solid var(--border-2);
    background: var(--surface);
  }
  .artist p {
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .card {
      padding: 28px 20px;
    }
    .cta {
      padding-bottom: 48px;
    }
  }
</style>
